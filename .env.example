# ---- Mobile / web app (build time) -----------------------------------------
# Public URL of the deployed backend, read at build time (npm run build). Never put secrets here.
# Leave unset for local development: the app uses port 8000 on the host it was opened from.
VITE_API_URL=https://your-backend.example.com

# ---- Backend (set on the host running backend/app.py) ----------------------
# SQLite file. On hosts with ephemeral disks, mount a persistent volume and point here.
DATABASE_PATH=/data/declare.sqlite3
# Comma-separated origins allowed to call the API from a browser. "*" is fine because
# sign-in uses bearer tokens, not cookies.
CORS_ORIGINS=*

# Email delivery for verification and password-reset codes. Required for public servers.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=your address,
#   SMTP_PASSWORD=a 16-character app password (needs 2-Step Verification), SMTP_FROM=your address.
# Port 465 (implicit TLS): set SMTP_USE_SSL=true and leave SMTP_STARTTLS unused.
# Port 587 (STARTTLS, most providers): keep SMTP_USE_SSL=false and SMTP_STARTTLS=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=smtp-user
SMTP_PASSWORD=smtp-password
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Local testing only. Shows codes in API responses when SMTP is not configured.
# Never set this on a public server.
ALLOW_DEVELOPMENT_CODES=false
