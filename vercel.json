{
  "public": true,
  "buildCommand": "npm ci && EXPO_PUBLIC_API_URL=/api npx --no-install expo export --platform web",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
